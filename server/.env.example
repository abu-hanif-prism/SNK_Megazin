# Copy to .env on each device and adjust.
PORT=8080
DB_FILE=snapnkeep.sqlite3

# CUPS
CUPS_MAX_IN_FLIGHT=2
CUPS_POLL_MS=2000
# PRINTER_NAME=G1020USB        # empty = system default printer
# MOCK_CUPS=true               # dev machines only (mac/windows, no printer)

# First-boot admin password seed (change from the console afterwards)
INITIAL_ADMIN_PASSWORD=snapnkeep
JWT_LIFETIME=30d

UPLOAD_LIMIT_MB=25
